// Gaïa — Prisma schema (Postgres / Supabase).
//
// Minimal schema: User + AuthSession (minimal auth, see src/server/session.ts)
// + the 5 Gaïa models, copied verbatim from Promethe
// (Features-promethe, head b859140, prisma/schema.prisma lines ~2275-2367).
// Conventions kept from Promethe:
//  - snake_case DB columns via @map, camelCase in TS
//  - lists / block JSON stored as JSON-encoded strings (String columns)
//  - no enums: status-like values are String, validated by Zod at the edge
//
// Differences vs Promethe (documented, deliberate):
//  - User carries displayName + timezone directly. In Promethe those live in
//    a separate Profile table (id === users.id); Gaïa has no Profile table,
//    the session payload is synthesised from these two columns instead.
//  - DIRECT_URL (added 18 Nov 2026, like Promethe): Prisma uses it for DDL
//    (`prisma db push`); DATABASE_URL stays the pooled runtime connection.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth (minimal — same principle as Promethe: opaque token + AuthSession)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  /// Display name shown in the header (Promethe: Profile.displayName).
  displayName  String   @default("") @map("display_name")
  /// IANA timezone, e.g. "America/Toronto" (Promethe: Profile.timezone).
  timezone     String   @default("UTC")
  /// Module 1 — objectif d'écriture quotidien (mots), 0 = aucun.
  dailyWordGoal Int     @default(0) @map("daily_word_goal")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  authSessions AuthSession[]

  // ── Gaïa — workspace de notes ──
  gaiaNotes       Note[]
  gaiaFolders     NoteFolder[]
  gaiaTags        NoteTag[]
  gaiaTemplates   NoteTemplate[]
  gaiaVersions    NoteVersion[]
  // Module 2 — Knowledge Management System.
  gaiaRelations   NoteRelation[]
  gaiaCollections SmartCollection[]
  gaiaCanvases    KnowledgeCanvas[]
  gaiaInbox       InboxItem[]

  @@map("users")
}

/// Server-side session store; the httpOnly cookie only holds the opaque session id.
model AuthSession {
  id        String   @id
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Gaïa — workspace de notes (verbatim from Promethe)
// ─────────────────────────────────────────────────────────────────────────────
// (une table par entité, JSON stocké en String comme Trade.customFields).
// Le contenu humain est en français ; les ids machine restent en anglais.
// ─────────────────────────────────────────────────────────────────────────────

/// Une note Gaïa : titre, dossier, tags, blocs JSON (voir src/lib/gaia/content.ts).
model Note {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  title        String    @default("")
  icon         String?
  folderId     String?   @map("folder_id")
  /// JSON string[] des ids de NoteTag.
  tagIds       String    @default("[]") @map("tag_ids")
  favorite     Boolean   @default(false)
  templateId   String?   @map("template_id")
  /// JSON GaiaBlock[] (contenu éditorial, jamais de HTML brut).
  blocks       String    @default("[]")
  /// Module 1 — couverture : JSON { kind: "image" | "gradient", value: string }.
  cover        String?
  /// Module 1 — objectif d'écriture de cette note (mots), null = aucun.
  wordGoal     Int?      @map("word_goal")
  /// Module 2 (K13) — propriétés : JSON GaiaNoteProperty[] (clé/valeur typée).
  properties   String    @default("[]")
  lastViewedAt DateTime? @map("last_viewed_at")
  deletedAt    DateTime? @map("deleted_at")
  // ── Phase 1 — Memory (Heat Memory System + spaced repetition, 18 Nov 2026).
  // Mastery is a plain String (no Prisma enum, same convention as the
  // other status-like values): "forgotten" | "fragile" | "medium" |
  // "mastered", validated by Zod at the edge (src/lib/gaia/spaced-repetition.ts).
  // nextReviewAt is null for notes created before this feature — null means
  // "never reviewed", i.e. due for review.
  mastery       String    @default("fragile")
  lastReviewedAt DateTime? @map("last_reviewed_at")
  nextReviewAt  DateTime? @map("next_review_at")
  reviewCount   Int       @default(0) @map("review_count")
  easeFactor    Float     @default(2.5) @map("ease_factor")
  intervalDays  Int       @default(0) @map("interval_days")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder   NoteFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  versions NoteVersion[]

  @@index([userId])
  @@index([userId, folderId])
  @@index([userId, nextReviewAt])
  @@map("gaia_notes")
}

/// Dossier de notes (nom unique par utilisateur, insensible à la casse).
/// Module 2 (K05) : dossiers imbriqués via parentId (null = racine).
model NoteFolder {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  parentId  String?  @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   NoteFolder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children NoteFolder[] @relation("FolderChildren")
  notes    Note[]

  @@index([userId])
  @@index([userId, parentId])
  @@map("gaia_folders")
}

/// Tag de notes (nom unique par utilisateur, insensible à la casse, "#" retiré).
/// Module 2 (K07) : tags hiérarchiques via parentId + relations explicites
/// (JSON string[] d'ids de tags, ex. synonymes / tags liés).
model NoteTag {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  name       String
  parentId   String?  @map("parent_id")
  relatedIds String   @default("[]") @map("related_ids")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   NoteTag?  @relation("TagChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children NoteTag[] @relation("TagChildren")

  @@index([userId])
  @@index([userId, parentId])
  @@map("gaia_tags")
}

/// Module 2 (K08) — relation personnalisée entre deux notes.
/// `type` est un libellé libre ("relates to", "contradicts", "inspired by"…).
/// Une paire (from, to, type) est unique ; la relation est orientée mais
/// lisible dans les deux sens (le graphe et l'explorateur l'affichent
/// des deux côtés).
model NoteRelation {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  fromNoteId String   @map("from_note_id")
  toNoteId   String   @map("to_note_id")
  type       String   @default("relates to")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fromNoteId, toNoteId, type])
  @@index([userId, fromNoteId])
  @@index([userId, toNoteId])
  @@map("gaia_note_relations")
}

/// Module 2 (K06) — collection dynamique : une requête sauvegardée.
/// `criteria` est un JSON GaiaCollectionCriteria (dossier, tags, mastery,
/// favori, recherche texte, propriétés). Évaluée à la lecture.
model SmartCollection {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  icon      String   @default("📁")
  criteria  String   @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("gaia_smart_collections")
}

/// Module 2 (K09) — canvas de connaissances : des cartes (notes) posées
/// librement sur un plan. `items` est un JSON GaiaCanvasItem[].
model KnowledgeCanvas {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  items     String   @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("gaia_knowledge_canvases")
}

/// Module 2 (K12) — boîte de réception : capture rapide d'idées.
/// `noteId` est rempli à la conversion en note ; `doneAt` quand traitée.
model InboxItem {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  text      String
  doneAt    DateTime? @map("done_at")
  noteId    String?   @map("note_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, doneAt])
  @@map("gaia_inbox_items")
}

/// Modèle de note créé par l'utilisateur. Les 5 modèles built-in (tpl-...)
/// vivent dans le code (src/lib/gaia/templates.ts) et ne sont jamais persistés.
model NoteTemplate {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  name        String
  description String   @default("")
  icon        String   @default("📄")
  /// JSON GaiaBlock[] (les blocs ref sont supprimés à la création).
  blocks      String   @default("[]")
  builtIn     Boolean  @default(false) @map("built_in")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("gaia_templates")
}

/// Snapshot immuable d'une note avant modification (versioning, cap 12).
model NoteVersion {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  noteId    String   @map("note_id")
  title     String   @default("")
  /// JSON GaiaBlock[] tels qu'avant la modification.
  blocks    String   @default("[]")
  /// = updatedAt de la note AVANT la modification.
  savedAt   DateTime @map("saved_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([userId, noteId])
  @@index([noteId, savedAt])
  @@map("gaia_versions")
}
